# Copy this file to .env. Never commit .env.
# Pick ONE provider. Without any, the app runs offline (extractive answers).

# --- Option A: free, local, no key: Ollama (https://ollama.com) ---
# 1) install Ollama   2) ollama pull qwen2.5:7b
CITEBENCH_PROVIDER=ollama
CITEBENCH_MODEL=qwen2.5:7b
# CITEBENCH_BASE_URL=http://localhost:11434
# CITEBENCH_OLLAMA_NUM_CTX=8192

# --- Option B: Claude ---
# CITEBENCH_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# CITEBENCH_MODEL=claude-haiku-5-5

# --- Option C: any OpenAI-compatible API (Groq, OpenRouter, DeepSeek, ...) ---
# CITEBENCH_PROVIDER=openai_compatible
# CITEBENCH_BASE_URL=https://api.groq.com/openai/v1
# CITEBENCH_API_KEY=...
# CITEBENCH_MODEL=<model name from the provider>

# Retrieval
CITEBENCH_TOP_K=12
CITEBENCH_MAX_PER_PAPER=2
